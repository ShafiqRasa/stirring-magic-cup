{{ 'table.css' | asset_url | stylesheet_tag }}
{% assign custom_color = "" %}
{% if block.settings.cell-bg-color != "#ffffff" %}
  {% assign custom_color = "custom-color" %}
{% endif %}


{% if block.settings.type_of_cell == "header" %}
<th {{ block.shopify_attributes }} class="{{ custom_color }}" style="--text-alignment:{{ block.settings.text-alignment }}; --cell-bg:{{ block.settings.cell-bg-color }};--text-color:{{ block.settings.text-color }}">
{% elsif block.settings.type_of_cell == "body" %}
<td {{ block.shopify_attributes }} class="{{ custom_color }}" style="--text-alignment:{{ block.settings.text-alignment }}; --cell-bg:{{ block.settings.cell-bg-color }};--text-color:{{ block.settings.text-color }}">
{% endif %}

    {{ block.settings.cell-text }}

{% if block.settings.type_of_cell == "header" %}
</th>
{% elsif block.settings.type_of_cell == "body" %}
</td>
{% endif %}

{% javascript %}
  alert(has_cell_color)
{% endjavascript %}

{% schema %}
{
    "name": "Table Cell",
    "settings": [
        {
            "type": "select",
            "label": "Type of Cell",
            "options": [
                {
                    "value": "header",
                    "label": "Header Cell"
                },
                {
                    "value": "body",
                    "label": "Body Cell"
                }
            ],
            "id": "type_of_cell"
        },
        {
            "type": "text",
            "label": "Cell Text",
            "id": "cell-text",
            "default":"label"
        },
        {
            "type": "text_alignment",
            "id": "text-alignment",
            "default":"left",
            "label": "Text Alignment"
        },
        {
            "type": "color",
            "id": "cell-bg-color",
            "default": "#ffffff",
            "label": "Cell Background Color"
        },
        {
            "type": "color",
            "id": "text-color",
            "default": "#000000",
            "label": "Text Color"
        }

    ],
    "presets": [
        {
            "name": "Header Cell",
            "settings": {
                "type_of_cell":"header"
            }
        },
        {
            "name": "Body Cell",
            "settings": {
                "type_of_cell":"body"
            }
        }
    ]
}
{% endschema %}