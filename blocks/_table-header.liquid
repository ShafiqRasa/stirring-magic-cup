{{ 'table.css' | asset_url | stylesheet_tag }}

<thead {{ block.shopify_attributes }} style="--header-bg:{{ block.settings.header-bg-color }}">
    <tr>
        {% content_for 'blocks' %}
    </tr>
</thead>
{% schema %}
{
    "name": "Table Header",
    "settings": [
        {
            "type": "color",
            "id": "header-bg-color",
            "default": "#ffffff",
            "label": "Row Background Color"
        }
    ],
    "blocks": [
        {
            "type": "_table-cell"
        }
    ],
    "presets": [
        {
            "name": "Table Header"
        }
    ]
}
{% endschema %}