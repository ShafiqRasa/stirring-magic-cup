{{ 'table.css' | asset_url | stylesheet_tag }}
<div class="page-wdith" style="--table-alignment:{{ section.settings.table-alignment }}">
    <table>
        {% content_for 'block', type:'_table-header', id:'table-header' %} {% comment %} static single block{% endcomment %}
        <tbody>
            {% content_for 'blocks' %}
        </tbody>
    </table>
</div>

{% schema %}
{
    "name": "Table",
    "class": "table_section",
    "settings": [
        {
            "type": "select",
            "id": "table-alignment",
            "label": "Table Alignment",
            "default":"left",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center",
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ]

        }
    ],
    "blocks": [
        {
            "type": "_table-row"
       }
    ],
    "presets": [{
        "name": "Table"
    }]
}
{% endschema %}